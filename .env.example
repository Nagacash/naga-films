# Copy to `.env.local` for local development, or set these in your host
# dashboard (e.g. Vercel Environment Variables). Do not commit `.env.local`.
#
# Users can still paste an API key in the app UI — that key is theirs and
# stays in the browser / session; deploy uses the vars below when you proxy
# to backends or enable server-side AI routes.

# OpenRouter (Hyperframes chat, agents OpenRouter branches, etc.)
OPENROUTER_API_KEY=
# OPENROUTER_KEY=

# Optional: default model unless overridden per-feature
OPENROUTER_MODEL=

# Optional: per-route model overrides (see lib/openrouter-chat.js)
# HYPERFRAMES_OPENROUTER_MODEL=
# AGENTS_OPENROUTER_MODEL=

OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=

# Optional: MuAPI server default (when routes read server env)
MUAPI_API_KEY=
