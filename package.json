{
  "name": "naga-films-studio",
  "description": "Naga Films Studio — self-hostable AI image, video, cinema and lip-sync studio. A Naga Films distribution of Open Generative AI (MIT).",
  "homepage": "https://github.com/Nagacash/naga-films",
  "private": true,
  "version": "1.0.10",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:packages && next build",
    "start": "next start",
    "lint": "next lint",
    "build:studio": "pnpm --filter ./packages/studio run build",
    "build:workflow": "pnpm --filter ./packages/Vibe-Workflow/packages/workflow-builder run build",
    "build:agent": "pnpm --filter ./packages/Open-Poe-AI/packages/agents run build",
    "build:packages": "node scripts/build-packages.js",
    "setup": "git submodule update --init --recursive && pnpm install && pnpm run build:packages",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:dev": "pnpm run vite:build && electron .",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:all": "vite build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "cloud.nagacodex.nagafilmsstudio",
    "productName": "Naga Films Studio",
    "copyright": "© Naga Films / Naga Codex. Built on Open Generative AI (MIT).",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "public/banner.png",
      "category": "Utility",
      "maintainer": "Naga Films Studio Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "workspace:*",
    "zustand": "^5.0.13",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder",
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  },
  "main": "electron/main.js",
  "packageManager": "pnpm@10.33.2"
}
